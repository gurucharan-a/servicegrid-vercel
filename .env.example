# Copy to .env — Supabase Postgres + NextAuth + optional Claude/Telegram.
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
VITE_CLAUDE_API_KEY=""
VITE_NOTIFY_WEBHOOK=""
# ServiceGrid auth (production): JWT issuer/audience + refresh TTL.
# Demo AuthGate uses services/auth.ts `login()` locally; swap its body for
# POST /api/v1/auth/login and set these alongside NEXTAUTH_SECRET.
AUTH_JWT_ISSUER="servicegrid"
AUTH_JWT_TTL_MIN="30"
AUTH_REFRESH_TTL_DAYS="7"
# ServiceGrid AI layer (optional — defaults keep everything working offline).
# AI_PROVIDER selects the aiService provider ("mock" today; a future
# "openrouter"/custom id must be implemented in src/services/ai/ first).
# AI_API_URL is a reserved placeholder; never put secrets in frontend code.
VITE_AI_ENABLED="true"
VITE_AI_PROVIDER="mock"
VITE_AI_API_URL=""
